# Copy to .env.local and fill in. Never commit real keys.

DATABASE_URL=postgres://galaxidea:galaxidea@localhost:5432/galaxidea

# Any OpenAI-compatible chat endpoint. Swap the provider by changing these three.
# Optional: without them a report is built from the search results alone.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Multilingual embedding model. EMBED_DIM must match the embedding column in db/migrations.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIM=512
# Only for providers that distinguish stored documents from search queries
# (Voyage: "document" here, "query" when embedding a question).
EMBED_INPUT_TYPE=
# Request field that sets the output size, for models with several sizes
# (Voyage: output_dimension, OpenAI: dimensions).
EMBED_DIM_PARAM=
# `input_type` sent when embedding a question (Voyage: query).
EMBED_QUERY_INPUT_TYPE=

# GitHub token for the collection script (public read is enough).
GITHUB_TOKEN=

# Google Cloud service account key (the whole JSON) for the patent collector.
GCP_SA_KEY=
